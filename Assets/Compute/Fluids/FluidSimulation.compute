#pragma kernel Advection
#pragma kernel ExternalForces
#pragma kernel ComputeDivergence
#pragma kernel PressureProjection
#pragma kernel ApplyBoundaryConditions
#pragma kernel AddFluidSource
#pragma kernel UpdateBoundariesFromSolids
#pragma kernel ConvertFluidToVoxelVolume
#pragma kernel InitializeFluidVolume

#include "Assets/Compute/Fluids/Include/FluidVolume.hlsl"

// Additional buffers
RWStructuredBuffer<float> divergenceBuffer; // Temporary buffer for divergence

RWStructuredBuffer<PackedVoxel> outputVoxelVolume; // For DualContouring
float fluidDensityThreshold;

// Simulation parameters
float deltaTime;
float viscosity;
float3 gravity;

// Fluid source parameters
uint sourceMaterial;
float3 sourcePosition;
float3 sourceVelocity;
float sourceAmount;
float sourceRadius;

[numthreads(4, 4, 4)]
void InitializeFluidVolume(uint3 id : SV_DispatchThreadID)
{
    if (IsOutOfFluidVolumeBounds(id))
        return;
        
    // Initialize with empty fluid voxel
    FluidVoxel voxel = FluidVoxel::Create();
    voxel.voxel = Voxel::Create(float4(1.0f, 0, 0, 0), 0); // Empty space (positive SDF)
    voxel.velocity = float3(0, 0, 0);
    voxel.pressure = 0.0f;
    voxel.temperature = 0.0f;
    voxel.density = 0.0f;
    
    SetFluidVoxel(id, voxel);
    SetFluidVoxelBackBuffer(id, voxel);
}

[numthreads(4, 4, 4)]
void AddFluidSource(uint3 id : SV_DispatchThreadID)
{
    if (IsOutOfFluidVolumeBounds(id))
        return;
        
    FluidVoxel voxel = GetFluidVoxel(id);
    
    // Skip if this is a solid boundary
    if (voxel.IsSolid())
        return;
    
    // Calculate distance from source position
    float3 voxelWorldPos = FluidVolumeToWorldSpace(FluidVoxelToVolumeSpace(id));
    float distance = length(voxelWorldPos - sourcePosition);
    
    // Add fluid within source radius
    if (distance < sourceRadius)
    {
        float falloff = 1.0f - (distance / sourceRadius);
        falloff = smoothstep(0, 1, falloff);
        
        // Add density
        float densityIncrease = sourceAmount * falloff * deltaTime;
        voxel.density = min(voxel.density + densityIncrease, 1.0f); // Clamp to max density
        
        // Set velocity towards source velocity
        if (voxel.density > 0.001f)
        {
            float velocityBlend = falloff * deltaTime * 5.0f; // Faster velocity blending
            voxel.velocity = lerp(voxel.velocity, sourceVelocity, min(velocityBlend, 1.0f));
            
            // Mark as fluid material
            voxel.voxel.materialIndex = sourceMaterial;
            
            // Update SDF to be negative (inside fluid)
            voxel.voxel.valueAndGradient.x = -voxel.density;
        }
        
        // Debug: Force a minimum density in source area for testing
        if (distance < sourceRadius * 0.5f)
        {
            voxel.density = max(voxel.density, 0.1f);
            voxel.voxel.valueAndGradient.x = -0.5f; // Strong negative SDF
            voxel.voxel.materialIndex = sourceMaterial;
        }
    }
    
    SetFluidVoxel(id, voxel);
}

[numthreads(4, 4, 4)]
void Advection(uint3 id : SV_DispatchThreadID)
{
    if (IsOutOfFluidVolumeBounds(id))
        return;
        
    FluidVoxel voxel = GetFluidVoxel(id);
    
    // Skip empty or solid voxels
    if (!voxel.IsFluid() || voxel.density < 0.001f)
    {
        SetFluidVoxelBackBuffer(id, voxel);
        return;
    }
    
    // Semi-Lagrangian advection
    float3 worldPos = FluidVolumeToWorldSpace(FluidVoxelToVolumeSpace(id));
    
    // Trace backwards through the velocity field
    float3 prevWorldPos = worldPos - voxel.velocity * deltaTime;
    
    // Sample values at previous position
    FluidVoxel sampledVoxel = SampleFluidVoxelTrilinear(prevWorldPos);
    
    // Create new voxel with advected values
    FluidVoxel newVoxel = FluidVoxel::Create();
    newVoxel.voxel = sampledVoxel.voxel;
    newVoxel.density = sampledVoxel.density;
    newVoxel.velocity = sampledVoxel.velocity;
    newVoxel.temperature = sampledVoxel.temperature;
    newVoxel.pressure = voxel.pressure; // Pressure is updated in separate step
    
    // Apply some numerical dissipation to prevent instabilities
    float dissipation = 0.99f;
    newVoxel.density *= dissipation;
    
    // Ensure fluid properties are maintained
    if (newVoxel.density > 0.001f)
    {
        newVoxel.voxel.valueAndGradient.x = -newVoxel.density;
        newVoxel.voxel.materialIndex = sourceMaterial;
    }
    
    SetFluidVoxelBackBuffer(id, newVoxel);
}

[numthreads(4, 4, 4)]
void ExternalForces(uint3 id : SV_DispatchThreadID)
{
    if (IsOutOfFluidVolumeBounds(id))
        return;
        
    FluidVoxel voxel = GetFluidVoxelBackBuffer(id);
    
    // Only apply forces to fluid voxels
    if (voxel.IsFluid() && voxel.density > 0.001f)
    {
        // Apply gravity
        voxel.velocity += gravity * deltaTime;
        
        // Apply viscosity (simplified - full implementation would use Laplacian)
        voxel.velocity *= (1.0f - viscosity * deltaTime);
        
        // Maintain fluid SDF
        voxel.voxel.valueAndGradient.x = -voxel.density;
    }
    
    SetFluidVoxel(id, voxel);
}

[numthreads(4, 4, 4)]
void ComputeDivergence(uint3 id : SV_DispatchThreadID)
{
    if (IsOutOfFluidVolumeBounds(id))
        return;
        
    uint index = CalculateFluidVolumeIndex(id);
    FluidVoxel voxel = GetFluidVoxel(id);
    
    // Skip non-fluid voxels
    if (!voxel.IsFluid() || voxel.density < 0.001f)
    {
        divergenceBuffer[index] = 0.0f;
        return;
    }
    
    // Compute divergence using central differences
    float divergence = 0.0f;
    
    // X-axis
    if (id.x > 0 && id.x < numberOfVoxels.x - 1)
    {
        FluidVoxel voxelXMinus = GetFluidVoxel(id - uint3(1, 0, 0));
        FluidVoxel voxelXPlus = GetFluidVoxel(id + uint3(1, 0, 0));
        
        float velXMinus = (voxelXMinus.IsFluid() && voxelXMinus.density > 0.001f) ? voxelXMinus.velocity.x : 0.0f;
        float velXPlus = (voxelXPlus.IsFluid() && voxelXPlus.density > 0.001f) ? voxelXPlus.velocity.x : 0.0f;
        
        divergence += (velXPlus - velXMinus) / (2.0f * voxelSpacing);
    }
    
    // Y-axis
    if (id.y > 0 && id.y < numberOfVoxels.y - 1)
    {
        FluidVoxel voxelYMinus = GetFluidVoxel(id - uint3(0, 1, 0));
        FluidVoxel voxelYPlus = GetFluidVoxel(id + uint3(0, 1, 0));
        
        float velYMinus = (voxelYMinus.IsFluid() && voxelYMinus.density > 0.001f) ? voxelYMinus.velocity.y : 0.0f;
        float velYPlus = (voxelYPlus.IsFluid() && voxelYPlus.density > 0.001f) ? voxelYPlus.velocity.y : 0.0f;
        
        divergence += (velYPlus - velYMinus) / (2.0f * voxelSpacing);
    }
    
    // Z-axis
    if (id.z > 0 && id.z < numberOfVoxels.z - 1)
    {
        FluidVoxel voxelZMinus = GetFluidVoxel(id - uint3(0, 0, 1));
        FluidVoxel voxelZPlus = GetFluidVoxel(id + uint3(0, 0, 1));
        
        float velZMinus = (voxelZMinus.IsFluid() && voxelZMinus.density > 0.001f) ? voxelZMinus.velocity.z : 0.0f;
        float velZPlus = (voxelZPlus.IsFluid() && voxelZPlus.density > 0.001f) ? voxelZPlus.velocity.z : 0.0f;
        
        divergence += (velZPlus - velZMinus) / (2.0f * voxelSpacing);
    }
    
    divergenceBuffer[index] = divergence;
}

[numthreads(4, 4, 4)]
void PressureProjection(uint3 id : SV_DispatchThreadID)
{
    if (IsOutOfFluidVolumeBounds(id))
        return;
        
    uint index = CalculateFluidVolumeIndex(id);
    FluidVoxel voxel = GetFluidVoxel(id);
    
    // Skip non-fluid voxels
    if (!voxel.IsFluid() || voxel.density < 0.001f)
    {
        voxel.pressure = 0.0f;
        SetFluidVoxelBackBuffer(id, voxel);
        return;
    }
    
    // Jacobi iteration for pressure solve
    float pressureSum = 0.0f;
    int neighborCount = 0;
    
    // Sample neighboring pressures
    uint3 offsets[6] = {
        uint3(-1, 0, 0), uint3(1, 0, 0),
        uint3(0, -1, 0), uint3(0, 1, 0),
        uint3(0, 0, -1), uint3(0, 0, 1)
    };
    
    for (int i = 0; i < 6; i++)
    {
        uint3 neighborCoord = id + int3(offsets[i]);
        
        // Check bounds
        if (any(neighborCoord >= numberOfVoxels))
            continue;
            
        FluidVoxel neighbor = GetFluidVoxel(neighborCoord);
        if (neighbor.IsFluid() && neighbor.density > 0.001f)
        {
            pressureSum += neighbor.pressure;
            neighborCount++;
        }
    }
    
    // Update pressure based on divergence
    if (neighborCount > 0)
    {
        float divergence = divergenceBuffer[index];
        voxel.pressure = (pressureSum - divergence * voxel.density * voxelSpacing * voxelSpacing) / float(neighborCount);
    }
    
    // Update velocity based on pressure gradient
    float3 pressureGradient = float3(0, 0, 0);
    
    // Calculate pressure gradient
    for (int i = 0; i < 6; i++)
    {
        uint3 neighborCoord = id + int3(offsets[i]);
        
        if (any(neighborCoord >= numberOfVoxels))
            continue;
            
        FluidVoxel neighbor = GetFluidVoxel(neighborCoord);
        float neighborPressure = (neighbor.IsFluid() && neighbor.density > 0.001f) ? neighbor.pressure : voxel.pressure;
        
        // Add to gradient based on direction
        if (i < 2) // X direction
        {
            float sign = (i == 0) ? -1.0f : 1.0f;
            pressureGradient.x += sign * neighborPressure / (2.0f * voxelSpacing);
        }
        else if (i < 4) // Y direction
        {
            float sign = (i == 2) ? -1.0f : 1.0f;
            pressureGradient.y += sign * neighborPressure / (2.0f * voxelSpacing);
        }
        else // Z direction
        {
            float sign = (i == 4) ? -1.0f : 1.0f;
            pressureGradient.z += sign * neighborPressure / (2.0f * voxelSpacing);
        }
    }
    
    // Subtract pressure gradient from velocity (making it divergence-free)
    if (voxel.density > 0.001f)
    {
        voxel.velocity -= pressureGradient * deltaTime / voxel.density;
        
        // Maintain fluid SDF
        voxel.voxel.valueAndGradient.x = -voxel.density;
    }
    
    SetFluidVoxelBackBuffer(id, voxel);
}

[numthreads(4, 4, 4)]
void ApplyBoundaryConditions(uint3 id : SV_DispatchThreadID)
{
    if (IsOutOfFluidVolumeBounds(id))
        return;
        
    FluidVoxel voxel = GetFluidVoxelBackBuffer(id);
    
    // If this is a solid voxel, ensure no fluid
    if (voxel.IsSolid())
    {
        voxel.density = 0.0f;
        voxel.velocity = float3(0, 0, 0);
        voxel.pressure = 0.0f;
        voxel.voxel.valueAndGradient.x = 1.0f; // Positive SDF for solid
        SetFluidVoxel(id, voxel);
        return;
    }
    
    // Apply no-slip boundary conditions at solid interfaces
    bool hasFluid = voxel.IsFluid() && voxel.density > 0.001f;
    
    if (hasFluid)
    {
        // Check neighbors for solid boundaries
        uint3 offsets[6] = {
            uint3(-1, 0, 0), uint3(1, 0, 0),
            uint3(0, -1, 0), uint3(0, 1, 0),
            uint3(0, 0, -1), uint3(0, 0, 1)
        };
        
        for (int i = 0; i < 6; i++)
        {
            uint3 neighborCoord = id + int3(offsets[i]);
            
            if (any(neighborCoord >= numberOfVoxels))
                continue;
                
            FluidVoxel neighbor = GetFluidVoxelBackBuffer(neighborCoord);
            if (neighbor.IsSolid())
            {
                // Apply no-slip condition in the direction of the solid
                if (i < 2) // X direction
                    voxel.velocity.x *= 0.5f; // Reduced velocity near walls
                else if (i < 4) // Y direction
                    voxel.velocity.y *= 0.5f;
                else // Z direction
                    voxel.velocity.z *= 0.5f;
            }
        }
        
        // Maintain fluid SDF
        voxel.voxel.valueAndGradient.x = -voxel.density;
    }
    
    SetFluidVoxel(id, voxel);
}

[numthreads(4, 4, 4)]
void UpdateBoundariesFromSolids(uint3 id : SV_DispatchThreadID)
{
    if (IsOutOfFluidVolumeBounds(id))
        return;
    
    // Read solid voxel data
    Voxel solidVoxel = GetVoxel(id);
    FluidVoxel fluidVoxel = GetFluidVoxel(id);
    
    // Update fluid voxel type based on solid geometry
    if (solidVoxel.IsSolid())
    {
        // This is now a solid boundary - clear any fluid
        fluidVoxel.voxel = solidVoxel;
        fluidVoxel.density = 0.0f;
        fluidVoxel.velocity = float3(0, 0, 0);
        fluidVoxel.pressure = 0.0f;
    }
    else if (fluidVoxel.IsSolid() && !solidVoxel.IsSolid())
    {
        // Was solid but is now empty space - initialize as empty fluid space
        fluidVoxel.voxel = solidVoxel;
        fluidVoxel.density = 0.0f;
        fluidVoxel.velocity = float3(0, 0, 0);
        fluidVoxel.pressure = 0.0f;
    }
    
    SetFluidVoxel(id, fluidVoxel);
}

[numthreads(4, 4, 4)]
void ConvertFluidToVoxelVolume(uint3 id : SV_DispatchThreadID)
{
    if (IsOutOfFluidVolumeBounds(id))
        return;
        
    FluidVoxel fluidVoxel = GetFluidVoxel(id);
    Voxel outputVoxel;
    
    if (fluidVoxel.IsFluid() && fluidVoxel.density > 0.001f)
    {
        // Convert fluid density to signed distance field
        // Negative values = inside fluid (surface), positive = outside
        float sdfValue = fluidDensityThreshold - fluidVoxel.density;
        
        // Calculate gradient from fluid density field
        float3 gradient = CalculateFluidDensityGradient(id, fluidVoxel.density);
        
        // Ensure we have a valid gradient
        if (length(gradient) < 0.001f)
        {
            gradient = float3(0, 1, 0); // Default upward normal
        }
        
        // Create voxel with SDF value and calculated gradient
        outputVoxel = Voxel::Create(float4(sdfValue, gradient), fluidVoxel.voxel.materialIndex);
    }
    else if (fluidVoxel.IsSolid())
    {
        // Use existing solid geometry
        outputVoxel = fluidVoxel.voxel;
    }
    else
    {
        // Empty space - large positive SDF value
        outputVoxel = Voxel::Create(float4(10.0f, 0.0f, 1.0f, 0.0f), 0);
    }
    
    uint index = CalculateFluidVolumeIndex(id);
    outputVoxelVolume[index] = PackVoxel(outputVoxel);
}